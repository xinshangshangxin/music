{
  "name": "api",
  "type": "module",
  "version": "0.0.1",
  "description": "",
  "exports": {
    "import": {
      "types": "./dist/es/index.d.ts",
      "default": "./dist/es/index.js"
    },
    "require": {
      "types": "./dist/cjs/index.d.cts",
      "default": "./dist/cjs/index.cjs"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && concurrently npm:build:*",
    "build:bundle": "bunchee --no-clean --sourcemap --runtime node",
    "clean": "rimraf dist",
    "dev": "nodemon --signal SIGHUP",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "prettier": "prettier '**/*.{ts,json,md}'",
    "prettier:fix": "prettier --write '**/*.{ts,json,md}'",
    "start": "node --import @swc-node/register/esm-register ./src/index.ts"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.0.0",
    "@s4p/nedb": "^1.0.4",
    "@s4p/smdb": "^0.1.1",
    "axios": "^1.7.4",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.0",
    "koa-proxies": "^0.12.4",
    "node-helper": "workspace:^",
    "radash": "^12.1.0"
  },
  "devDependencies": {
    "@types/koa": "^2.13.6",
    "@types/koa-bodyparser": "^4.3.10",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.0",
    "@types/node-cron": "^3.0.11"
  }
}
