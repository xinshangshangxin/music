    "lint:fix": "eslint ./src --fix",
    "prettier": "prettier '**/*.{ts,json,md}'",
    "prettier:fix": "prettier --write '**/*.{ts,json,md}'",
    "start": "node --import @swc-node/register/esm-register src/index.ts"
